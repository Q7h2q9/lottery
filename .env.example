# Copy this file to `.env` (gitignored) and fill in real values.
# ctfdraw auto-loads `.env` at startup via ctfdraw/_envloader.py — variables
# only enter the ctfdraw process and its agentflow/pi children, never your
# shell or other Claude instances.

# API key for whichever pi provider your ~/.pi/agent/models.json wires up.
# The variable NAME below must match the `apiKey` field in models.json.
ZIMO_API_KEY=sk-your-zimo-relay-token-here

# Optional: extra PATH entries for tools ctfdraw spawns (pi CLI, etc.).
# If empty, the loader auto-prepends ~/.npm-global/bin when ~/.npm-global/bin/pi
# exists. Set this only when you need a non-default location.
# CTFDRAW_EXTRA_PATH=/opt/custom/bin
